{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "morph:absorb_burst",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/morph_flake"
      }
    },
    "components": {
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * (1.0 - variable.particle_age / variable.particle_lifetime * 0.7)",
          "variable.size * (1.0 - variable.particle_age / variable.particle_lifetime * 0.7)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.size = 0.12;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 70
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.4,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "math.random(3, 6)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-600, 600)"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.6 + math.random(0, 0.6)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -1.5,
          0
        ],
        "linear_drag_coefficient": 4
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.55 + variable.particle_random_2 * 0.45",
          "0.15 + variable.particle_random_3 * 0.35",
          "1.0",
          "1.0 - math.pow(variable.particle_age / variable.particle_lifetime, 2.0)"
        ]
      }
    }
  }
}