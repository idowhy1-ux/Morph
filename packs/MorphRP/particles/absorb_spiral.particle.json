{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "morph:absorb_spiral",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/morph_flake"
      }
    },
    "components": {
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * (1.0 - variable.particle_age / variable.particle_lifetime * 0.7)",
          "variable.size * (1.0 - variable.particle_age / variable.particle_lifetime * 0.7)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.size = 0.07;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 70,
        "max_particles": 140
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.5
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.0
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(variable.particle_age * 540 + variable.particle_random_1 * 360) * (1.4 - variable.particle_age * 1.1)",
          "variable.particle_random_4 * 0.4 + variable.particle_age * 1.9",
          "math.sin(variable.particle_age * 540 + variable.particle_random_1 * 360) * (1.4 - variable.particle_age * 1.1)"
        ]
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.55 + variable.particle_random_2 * 0.45",
          "0.15 + variable.particle_random_3 * 0.35",
          "1.0",
          "1.0 - math.pow(variable.particle_age / variable.particle_lifetime, 2.0)"
        ]
      }
    }
  }
}