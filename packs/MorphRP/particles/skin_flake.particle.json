{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "morph:skin_flake",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/morph_flake"
      }
    },
    "components": {
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * (1.0 - variable.particle_age / variable.particle_lifetime * 0.7)",
          "variable.size * (1.0 - variable.particle_age / variable.particle_lifetime * 0.7)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.size = 0.09;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 5
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.35,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": 0.8,
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-400, 400)"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.5 + math.random(0, 0.5)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.6,
          0
        ],
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(variable.color.r, 0.75, variable.particle_age / variable.particle_lifetime)",
          "math.lerp(variable.color.g, 0.25, variable.particle_age / variable.particle_lifetime)",
          "math.lerp(variable.color.b, 1.0, variable.particle_age / variable.particle_lifetime)",
          "1.0 - math.pow(variable.particle_age / variable.particle_lifetime, 2.0)"
        ]
      }
    }
  }
}